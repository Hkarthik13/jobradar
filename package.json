{
  "name": "jobradar",
  "version": "1.0.0",
  "description": "JOB RADAR - Find who's hiring around you. Mobile-first geospatial job discovery & walk-in alert PWA.",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "build": "npm --workspace=shared run build && npm --workspace=client run build && npm --workspace=server run build",
    "start": "npm --workspace=server run start",
    "test": "npm --workspace=server run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "job-radar",
    "pwa",
    "geospatial",
    "walk-in-interviews",
    "nearby-jobs",
    "postgis",
    "leaflet",
    "radar-ui"
  ],
  "author": "JOB RADAR Team",
  "license": "MIT"
}
