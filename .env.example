# ==============================================================================
# JOB RADAR - Environment Configuration
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=jobradar-super-secret-production-key-2026

# PostgreSQL + PostGIS (Optional - automatically falls back to in-memory PostGIS simulator)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobradar_db

# Telegram Bot Alert Channel (Optional - displays in mock mode if unconfigured)
# Create your bot via @BotFather on Telegram to get your BOT_TOKEN
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Email / SMTP Alerts (Optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=alerts@jobradar.local

# Scheduled Background Scanner
SCANNER_CRON=0 */6 * * *
AUTO_SCAN_ON_STARTUP=true
